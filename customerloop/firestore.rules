rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is owner
    function isOwner() {
      return isAuthenticated() && getUserRole() == 'owner';
    }
    
    // Helper function to check if user is customer
    function isCustomer() {
      return isAuthenticated() && getUserRole() == 'customer';
    }
    
    // Helper function to get user's shop ID
    function getUserShopId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId;
    }
    
    // Users collection - users can only read/write their own document
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Users cannot delete their own account
    }
    
    // Shops collection
    match /shops/{shopId} {
      // Owners can read their own shop
      allow read: if isAuthenticated() && 
                     (resource.data.ownerId == request.auth.uid || 
                      getUserShopId() == shopId);
      
      // Only owners can create shops (during registration)
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Only shop owners can update their shop
      allow update: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;
      
      // Shop owners can delete their shop
      allow delete: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;
      
      // Customers subcollection
      match /customers/{customerId} {
        // Owners can read/write their shop's customers
        // Customers can read their own profile
        allow read: if isAuthenticated() && 
                       (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                        getUserShopId() == shopId);
        
        allow create: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow update: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow delete: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
      }
      
      // Visits subcollection
      match /visits/{visitId} {
        // Owners can read/write visits for their shop
        // Customers can read their own visits
        allow read: if isAuthenticated() && 
                       (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                        getUserShopId() == shopId);
        
        allow create: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow update: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow delete: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
      }
      
      // Rewards subcollection
      match /rewards/{rewardId} {
        // Everyone in the shop can read rewards
        allow read: if isAuthenticated() && 
                       (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                        getUserShopId() == shopId);
        
        // Only owners can create/update/delete rewards
        allow create: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow update: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow delete: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
      }
      
      // Redemptions subcollection
      match /redemptions/{redemptionId} {
        // Owners can read all redemptions
        // Customers can read their own redemptions
        allow read: if isAuthenticated() && 
                       (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                        getUserShopId() == shopId);
        
        // Customers can create redemptions (redeem rewards)
        // Owners can also create redemptions on behalf of customers
        allow create: if isAuthenticated() && 
                         (getUserShopId() == shopId ||
                          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid);
        
        // Only owners can update/delete redemptions
        allow update: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow delete: if isAuthenticated() && 
                         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
      }
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        // Users in the shop can read all notifications
        // Owners can read all notifications in their shop
        allow read: if isAuthenticated() && 
                       (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                        getUserShopId() == shopId);
        
        // System can create notifications (via backend/functions)
        // Owners can create notifications for customers
        // Anyone authenticated can create (service handles this)
        allow create: if isAuthenticated();
        
        // Users can update notifications (mark as read)
        allow update: if isAuthenticated() && 
                         (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                          getUserShopId() == shopId);
        
        // Users can delete notifications
        allow delete: if isAuthenticated() && 
                         (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                          getUserShopId() == shopId);
      }
      
      // Settings subcollection
      match /settings/{settingId} {
        // Owners and customers can read settings
        allow read: if isAuthenticated() && 
                       (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
                        getUserShopId() == shopId);
        
        // Only owners can create/update settings
        allow create, update: if isAuthenticated() && 
                                 get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
        
        allow delete: if false; // Settings should not be deleted
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
